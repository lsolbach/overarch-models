digraph "ITIL (Version 5): Lifecycle activities and management practices" {
  labelloc= "t"
  label="ITIL (Version 5): Lifecycle activities and management practices"
  rankdir="LR"

  layout=dot
software_development_itil_v5__framework [shape=box style=filled fillcolor="#dddddd" label=<<B>ITIL (Version 5)</B><BR/><FONT POINT-SIZE="10"><I>A framework for managing digital<BR/>products and services and creating<BR/>value. </I></FONT>>]
software_development_itil_v5_practice__availability_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Availability Management</B><BR/><FONT POINT-SIZE="10"><I>Ensures products and services meet<BR/>agreed availability needs through<BR/>availability planning, resilience and<BR/>downtime reduction. </I></FONT>>]
software_development_itil_v5_practice__portfolio_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Portfolio Management</B><BR/><FONT POINT-SIZE="10"><I>Evaluates and prioritizes investments,<BR/>initiatives, products and services so<BR/>resources support organizational<BR/>objectives. </I></FONT>>]
software_development_itil_v5_practice__monitoring_and_event_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Monitoring and Event Management</B><BR/><FONT POINT-SIZE="10"><I>Observes products, services and<BR/>infrastructure, identifies meaningful<BR/>state changes and triggers appropriate<BR/>action. </I></FONT>>]
software_development_itil_v5_practice__service_level_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Level Management</B><BR/><FONT POINT-SIZE="10"><I>Establishes business-aligned service<BR/>targets and monitors performance against<BR/>agreed commitments. </I></FONT>>]
software_development_itil_v5_practice__service_catalogue_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Catalogue Management</B><BR/><FONT POINT-SIZE="10"><I>Maintains accurate information about<BR/>available services and how consumers can<BR/>access or request them. </I></FONT>>]
software_development_itil_v5_lifecycle__acquire [shape=box style=filled fillcolor="#dddddd" label=<<B>Acquire</B><BR/><FONT POINT-SIZE="10"><I>Obtain or allocate the resources,<BR/>components, capabilities and supplier<BR/>services needed to create or change a<BR/>product or service. </I></FONT>>]
software_development_itil_v5_practice__workforce_and_talent_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Workforce and Talent Management</B><BR/><FONT POINT-SIZE="10"><I>Ensures the organization has the skills,<BR/>capacity, roles and working environment<BR/>needed to achieve its objectives. </I></FONT>>]
software_development_itil_v5_practice__it_asset_management [shape=box style=filled fillcolor="#dddddd" label=<<B>IT Asset Management</B><BR/><FONT POINT-SIZE="10"><I>Manages the lifecycle of IT assets to<BR/>optimize their use, cost, risk and<BR/>value. </I></FONT>>]
software_development_itil_v5_practice__service_financial_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Financial Management</B><BR/><FONT POINT-SIZE="10"><I>Manages service-related budgeting,<BR/>costing, forecasting and financial<BR/>accountability. </I></FONT>>]
software_development_itil_v5_practice__relationship_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Relationship Management</B><BR/><FONT POINT-SIZE="10"><I>Builds and maintains effective<BR/>relationships with stakeholders,<BR/>customers and other parties to align<BR/>needs and expectations. </I></FONT>>]
software_development_itil_v5_practice__project_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Project Management</B><BR/><FONT POINT-SIZE="10"><I>Plans, coordinates and controls projects<BR/>to deliver agreed outcomes within<BR/>defined constraints and acceptable risk. </I></FONT>>]
software_development_itil_v5_practice__strategy_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Strategy Management</B><BR/><FONT POINT-SIZE="10"><I>Defines organizational direction and<BR/>aligns plans, capabilities and<BR/>investments with long-term goals. </I></FONT>>]
software_development_itil_v5_practice__deployment_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Deployment Management</B><BR/><FONT POINT-SIZE="10"><I>Moves new or changed components into<BR/>target environments, such as test,<BR/>staging and production. </I></FONT>>]
software_development_itil_v5_lifecycle__build [shape=box style=filled fillcolor="#dddddd" label=<<B>Build</B><BR/><FONT POINT-SIZE="10"><I>Create, configure, integrate and test<BR/>the product or its components, preparing<BR/>them for transition into use. </I></FONT>>]
software_development_itil_v5_practice__problem_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Problem Management</B><BR/><FONT POINT-SIZE="10"><I>Identifies and manages causes of<BR/>incidents, investigates recurring<BR/>failures and helps prevent future<BR/>incidents. </I></FONT>>]
software_development_itil_v5_practice__business_analysis [shape=box style=filled fillcolor="#dddddd" label=<<B>Business Analysis</B><BR/><FONT POINT-SIZE="10"><I>Identifies business needs, analyses<BR/>stakeholder requirements and evaluates<BR/>solution options to support valuable<BR/>outcomes. </I></FONT>>]
software_development_itil_v5_lifecycle__discover [shape=box style=filled fillcolor="#dddddd" label=<<B>Discover</B><BR/><FONT POINT-SIZE="10"><I>Explore needs, opportunities, context<BR/>and priorities that may justify creating<BR/>or changing a digital product or<BR/>service. </I></FONT>>]
software_development_itil_v5__lifecycle_model [shape=box style=filled fillcolor="#dddddd" label=<<B>Product and Service Lifecycle Model</B><BR/><FONT POINT-SIZE="10"><I>An eight-activity model for managing<BR/>digital products and services end to<BR/>end. </I></FONT>>]
software_development_itil_v5_lifecycle__design [shape=box style=filled fillcolor="#dddddd" label=<<B>Design</B><BR/><FONT POINT-SIZE="10"><I>Develop product and service solutions<BR/>that meet stakeholder needs, including<BR/>functionality, experience, architecture,<BR/>security and operability. </I></FONT>>]
software_development_itil_v5_practice__organizational_change_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Organizational Change Management</B><BR/><FONT POINT-SIZE="10"><I>Helps people and organizations adopt<BR/>changes through engagement,<BR/>communication, preparation and support. </I></FONT>>]
software_development_itil_v5_practice__knowledge_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Knowledge Management</B><BR/><FONT POINT-SIZE="10"><I>Ensures useful knowledge and information<BR/>are created, maintained, shared and<BR/>accessible to those who need them. </I></FONT>>]
software_development_itil_v5_practice__service_design [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Design</B><BR/><FONT POINT-SIZE="10"><I>Designs services to meet stakeholder<BR/>needs, considering experience,<BR/>operations, security, performance and<BR/>cost. </I></FONT>>]
software_development_itil_v5__product_service_practices [shape=box style=filled fillcolor="#dddddd" label=<<B>Product and Service Management practices</B><BR/><FONT POINT-SIZE="10"><I>The official group of 22 ITIL (Version<BR/>5) management practices focused on<BR/>products and services. </I></FONT>>]
software_development_itil_v5_practice__service_request_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Request Management</B><BR/><FONT POINT-SIZE="10"><I>Handles predefined user requests for<BR/>information, access, standard services<BR/>or other agreed fulfilment activities. </I></FONT>>]
software_development_itil_v5_lifecycle__operate [shape=box style=filled fillcolor="#dddddd" label=<<B>Operate</B><BR/><FONT POINT-SIZE="10"><I>Run and maintain products and supporting<BR/>systems in the live environment, meeting<BR/>performance, reliability and operational<BR/>needs. </I></FONT>>]
software_development_itil_v5_practice__incident_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Incident Management</B><BR/><FONT POINT-SIZE="10"><I>Restores normal service as quickly as<BR/>practical after an interruption or<BR/>degradation, minimizing business impact. </I></FONT>>]
software_development_itil_v5_lifecycle__deliver [shape=box style=filled fillcolor="#dddddd" label=<<B>Deliver</B><BR/><FONT POINT-SIZE="10"><I>Make digital services available to<BR/>consumers and enable the agreed service<BR/>outcomes and experience. </I></FONT>>]
software_development_itil_v5_practice__infrastructure_and_platform_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Infrastructure and Platform Management</B><BR/><FONT POINT-SIZE="10"><I>Manages the infrastructure and platforms<BR/>underpinning digital products and<BR/>services, including their operation and<BR/>evolution. </I></FONT>>]
software_development_itil_v5_practice__service_configuration_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Configuration Management</B><BR/><FONT POINT-SIZE="10"><I>Maintains information about<BR/>configuration items and their<BR/>relationships to support effective<BR/>service management. </I></FONT>>]
software_development_itil_v5_practice__service_desk [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Desk</B><BR/><FONT POINT-SIZE="10"><I>Provides a central point of contact for<BR/>users and coordinates communications,<BR/>assistance and support. </I></FONT>>]
software_development_itil_v5_practice__measurement_and_reporting [shape=box style=filled fillcolor="#dddddd" label=<<B>Measurement and Reporting</B><BR/><FONT POINT-SIZE="10"><I>Defines measures, collects reliable data<BR/>and reports performance to support<BR/>decisions and demonstrate outcomes. </I></FONT>>]
software_development_itil_v5_lifecycle__support [shape=box style=filled fillcolor="#dddddd" label=<<B>Support</B><BR/><FONT POINT-SIZE="10"><I>Help consumers and restore normal<BR/>operation when issues affect products or<BR/>service delivery. </I></FONT>>]
software_development_itil_v5_lifecycle__transition [shape=box style=filled fillcolor="#dddddd" label=<<B>Transition</B><BR/><FONT POINT-SIZE="10"><I>Move a new or changed product into the<BR/>live environment in a controlled and<BR/>prepared way. </I></FONT>>]
software_development_itil_v5_practice__service_validation_and_testing [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Validation and Testing</B><BR/><FONT POINT-SIZE="10"><I>Checks that new or changed products and<BR/>services meet requirements and are fit<BR/>for their intended use. </I></FONT>>]
software_development_itil_v5_practice__continual_improvement [shape=box style=filled fillcolor="#dddddd" label=<<B>Continual Improvement</B><BR/><FONT POINT-SIZE="10"><I>Identifies, prioritizes, implements and<BR/>evaluates improvements to products,<BR/>services, practices and performance. </I></FONT>>]
software_development_itil_v5_practice__risk_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Risk Management</B><BR/><FONT POINT-SIZE="10"><I>Identifies, assesses and treats<BR/>uncertainty that could affect<BR/>objectives, including threats and<BR/>opportunities. </I></FONT>>]
software_development_itil_v5_practice__software_development_and_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Software Development and Management</B><BR/><FONT POINT-SIZE="10"><I>Develops, maintains and evolves software<BR/>to meet stakeholder needs and required<BR/>quality standards. </I></FONT>>]
software_development_itil_v5_practice__supplier_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Supplier Management</B><BR/><FONT POINT-SIZE="10"><I>Manages supplier relationships and<BR/>performance to ensure external products<BR/>and services meet business and<BR/>contractual needs. </I></FONT>>]
software_development_itil_v5_practice__service_continuity_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Continuity Management</B><BR/><FONT POINT-SIZE="10"><I>Prepares the organization to maintain or<BR/>recover products and services after<BR/>serious disruptions. </I></FONT>>]
software_development_itil_v5__general_practices [shape=box style=filled fillcolor="#dddddd" label=<<B>General Management practices</B><BR/><FONT POINT-SIZE="10"><I>The official group of 12 ITIL (Version<BR/>5) management practices supporting<BR/>management across the organization. </I></FONT>>]
software_development_itil_v5_practice__information_security_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Information Security Management</B><BR/><FONT POINT-SIZE="10"><I>Protects information and manages<BR/>security risks affecting<BR/>confidentiality, integrity, availability<BR/>and related objectives. </I></FONT>>]
software_development_itil_v5_practice__change_enablement [shape=box style=filled fillcolor="#dddddd" label=<<B>Change Enablement</B><BR/><FONT POINT-SIZE="10"><I>Assesses change risk and authorizes<BR/>changes appropriately to increase<BR/>successful changes while minimizing<BR/>disruption. </I></FONT>>]
software_development_itil_v5_practice__capacity_and_performance_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Capacity and Performance Management</B><BR/><FONT POINT-SIZE="10"><I>Ensures products and services have<BR/>appropriate capacity and performance as<BR/>demand and business needs change. </I></FONT>>]
software_development_itil_v5_practice__architecture_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Architecture Management</B><BR/><FONT POINT-SIZE="10"><I>Defines and evolves structures,<BR/>standards and relationships so business<BR/>and technology components work<BR/>coherently. </I></FONT>>]
software_development_itil_v5_practice__release_management [shape=box style=filled fillcolor="#dddddd" label=<<B>Release Management</B><BR/><FONT POINT-SIZE="10"><I>Plans and coordinates making new or<BR/>changed products, features or services<BR/>available for use. </I></FONT>>]
 
