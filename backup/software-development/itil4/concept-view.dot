digraph "Concept Map for ITIL 4" {
  labelloc= "t"
  label="Concept Map for ITIL 4"

  layout=dot
software_development_itil4__governance [shape=box style=filled fillcolor="#dddddd" label=<<B>Governance</B><BR/><FONT POINT-SIZE="10"><I> </I></FONT>>]
software_development_itil4__continual_improvement_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Continual Improvement</B><BR/><FONT POINT-SIZE="10"><I>Align practices and services with<BR/>changing business needs through ongoing<BR/>improvement. </I></FONT>>]
software_development_itil4__organizational_change_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Organizational Change Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure changes are smoothly implemented<BR/>with minimal disruption. </I></FONT>>]
software_development_itil4__supplier_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Supplier Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure suppliers deliver value and meet<BR/>contractual commitments. </I></FONT>>]
software_development_itil4__knowledge_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Knowledge Management</B><BR/><FONT POINT-SIZE="10"><I>Maintain and improve the effective use<BR/>of information and knowledge. </I></FONT>>]
software_development_itil4__business_analysis_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Business Analysis</B><BR/><FONT POINT-SIZE="10"><I>Analyze business needs and recommend<BR/>solutions. </I></FONT>>]
software_development_itil4__incident_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Incident Management</B><BR/><FONT POINT-SIZE="10"><I>Restore normal service as quickly as<BR/>possible. </I></FONT>>]
software_development_itil4__collaborate_and_promote_visibility_principle [shape=box style=filled fillcolor="#dddddd" label=<<B>Collaborate and promote visibility</B><BR/><FONT POINT-SIZE="10"><I> </I></FONT>>]
software_development_itil4__keep_it_simple_and_practical_principle [shape=box style=filled fillcolor="#dddddd" label=<<B>Keep it simple and practical</B><BR/><FONT POINT-SIZE="10"><I> </I></FONT>>]
software_development_itil4__workforce_and_talent_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Workforce and Talent Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure the organization has the right<BR/>people with the right skills. </I></FONT>>]
software_development_itil4__infrastructure_and_platform_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Infrastructure and Platform Management</B><BR/><FONT POINT-SIZE="10"><I>Oversee infrastructure to support<BR/>services. </I></FONT>>]
software_development_itil4__service_continuity_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Continuity Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure service availability during major<BR/>disruptions. </I></FONT>>]
software_development_itil4__deployment_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Deployment Management</B><BR/><FONT POINT-SIZE="10"><I>Move new or changed components into live<BR/>environments. </I></FONT>>]
software_development_itil4__progress_iteratively_with_feedback_principle [shape=box style=filled fillcolor="#dddddd" label=<<B>Progress iteratively with feedback</B><BR/><FONT POINT-SIZE="10"><I> </I></FONT>>]
software_development_itil4__management_practices [shape=box style=filled fillcolor="#dddddd" label=<<B>Management Practices</B><BR/><FONT POINT-SIZE="10"><I>In ITIL, a management practice is a set<BR/>of organizational resources designed for<BR/>performing work or accomplishing an<BR/>objective. </I></FONT>>]
software_development_itil4__think_and_work_holistically_principle [shape=box style=filled fillcolor="#dddddd" label=<<B>Think and work holistically</B><BR/><FONT POINT-SIZE="10"><I> </I></FONT>>]
software_development_itil4__itil4 [shape=box style=filled fillcolor="#dddddd" label=<<B>ITIL 4</B><BR/><FONT POINT-SIZE="10"><I>ITIL (a.k.a Information Technology<BR/>Infrastructure Library) is a framework<BR/>with a set of practices (formerly<BR/>processes) for information technology<BR/>(IT) activities such as IT service<BR/>management (ITSM) and IT asset<BR/>management (ITAM) that focus on aligning<BR/>IT services with the needs of a<BR/>business. </I></FONT>>]
software_development_itil4__service_value_system [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Value System</B><BR/><FONT POINT-SIZE="10"><I>The ITIL service value system describes<BR/>how all the components and activities of<BR/>the organization work together as a<BR/>system to enable value creation. Each<BR/>organization’s service value system has<BR/>interfaces with other organizations,<BR/>forming an ecosystem that can, in turn,<BR/>facilitate value for those<BR/>organizations, their customers, and<BR/>other stakeholders. </I></FONT>>]
software_development_itil4__strategy_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Strategy Management</B><BR/><FONT POINT-SIZE="10"><I>Define and maintain the organization’s<BR/>direction and priorities. </I></FONT>>]
software_development_itil4__risk_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Risk Management</B><BR/><FONT POINT-SIZE="10"><I>Identify, assess, and control risks. </I></FONT>>]
software_development_itil4__guiding_principles [shape=box style=filled fillcolor="#dddddd" label=<<B>Guiding Principles</B><BR/><FONT POINT-SIZE="10"><I> </I></FONT>>]
software_development_itil4__optimize_and_automate_principle [shape=box style=filled fillcolor="#dddddd" label=<<B>Optimize and automate</B><BR/><FONT POINT-SIZE="10"><I> </I></FONT>>]
software_development_itil4__focus_on_value_principle [shape=box style=filled fillcolor="#dddddd" label=<<B>Focus on value</B><BR/><FONT POINT-SIZE="10"><I> </I></FONT>>]
software_development_itil4__service_configuration_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Configuration Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure accurate information about<BR/>configuration items. </I></FONT>>]
software_development_itil4__capacity_and_performance_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Capacity and Performance Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure services perform efficiently and<BR/>meet demand. </I></FONT>>]
software_development_itil4__release_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Release Management</B><BR/><FONT POINT-SIZE="10"><I>Make new and changed services available<BR/>for use. </I></FONT>>]
software_development_itil4__service_validation_and_testing_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Validation and Testing</B><BR/><FONT POINT-SIZE="10"><I>Ensure services meet requirements and<BR/>are fit for use. </I></FONT>>]
software_development_itil4__relationship_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Relationship Management</B><BR/><FONT POINT-SIZE="10"><I>Build and nurture relationships with<BR/>stakeholders. </I></FONT>>]
software_development_itil4__general_management_practices [shape=box style=filled fillcolor="#dddddd" label=<<B>General Management Practices</B><BR/><FONT POINT-SIZE="10"><I>General management practices have been<BR/>adopted and adapted for service<BR/>management from general business<BR/>management domains. </I></FONT>>]
software_development_itil4__architecture_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Architecture Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure the organization’s architecture<BR/>supports strategy and enables change. </I></FONT>>]
software_development_itil4__change_enablement_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Change Enablement</B><BR/><FONT POINT-SIZE="10"><I>Maximize successful changes while<BR/>minimizing risk. </I></FONT>>]
software_development_itil4__project_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Project Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure projects are delivered<BR/>successfully, on time, and within<BR/>budget. </I></FONT>>]
software_development_itil4__service_design_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Design</B><BR/><FONT POINT-SIZE="10"><I>Design services that meet business and<BR/>user requirements. </I></FONT>>]
software_development_itil4__monitoring_and_event_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Monitoring and Event Management</B><BR/><FONT POINT-SIZE="10"><I>Observe services and respond to events. </I></FONT>>]
software_development_itil4__measurement_and_reporting_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Measurement and Reporting</B><BR/><FONT POINT-SIZE="10"><I>Support decision-making through data<BR/>collection, analysis, and reporting. </I></FONT>>]
software_development_itil4__service_value_chain [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Value Chain</B><BR/><FONT POINT-SIZE="10"><I>The central element of the service value<BR/>system is the service value chain, an<BR/>operating model which outlines the key<BR/>activities required to respond to demand<BR/>and facilitate value realization through<BR/>the creation and management of products<BR/>and services. </I></FONT>>]
software_development_itil4__it_asset_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>IT Asset Management</B><BR/><FONT POINT-SIZE="10"><I>Plan and manage the lifecycle of IT<BR/>assets. </I></FONT>>]
software_development_itil4__service_desk_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Desk</B><BR/><FONT POINT-SIZE="10"><I>Provide a single point of contact for<BR/>users. </I></FONT>>]
software_development_itil4__service_request_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Request Management</B><BR/><FONT POINT-SIZE="10"><I>Handle user requests effectively and<BR/>efficiently. </I></FONT>>]
software_development_itil4__start_where_you_are_principle [shape=box style=filled fillcolor="#dddddd" label=<<B>Start where you are</B><BR/><FONT POINT-SIZE="10"><I> </I></FONT>>]
software_development_itil4__portfolio_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Portfolio Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure the organization has the right<BR/>mix of programs, projects, and services. </I></FONT>>]
software_development_itil4__software_development_and_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Software Development and Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure applications meet stakeholder<BR/>needs and are maintained. </I></FONT>>]
software_development_itil4__continual_improvement [shape=box style=filled fillcolor="#dddddd" label=<<B>Continual Improvement</B><BR/><FONT POINT-SIZE="10"><I> </I></FONT>>]
software_development_itil4__information_security_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Information Security Management</B><BR/><FONT POINT-SIZE="10"><I>Protect information by ensuring<BR/>confidentiality, integrity, and<BR/>availability. </I></FONT>>]
software_development_itil4__service_financial_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Financial Management</B><BR/><FONT POINT-SIZE="10"><I>Support financial planning and<BR/>management of service costs. </I></FONT>>]
software_development_itil4__service_level_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Level Management</B><BR/><FONT POINT-SIZE="10"><I>Set clear service targets and ensure<BR/>they are met. </I></FONT>>]
software_development_itil4__availability_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Availability Management</B><BR/><FONT POINT-SIZE="10"><I>Ensure services meet agreed availability<BR/>targets. </I></FONT>>]
software_development_itil4__problem_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Problem Management</B><BR/><FONT POINT-SIZE="10"><I>Reduce the likelihood and impact of<BR/>incidents by identifying root causes. </I></FONT>>]
software_development_itil4__technical_management_practices [shape=box style=filled fillcolor="#dddddd" label=<<B>Technical Management Practices</B><BR/><FONT POINT-SIZE="10"><I>Practices to support IT operations and<BR/>infrastructure. </I></FONT>>]
software_development_itil4__service_catalog_management_practice [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Catalog Management</B><BR/><FONT POINT-SIZE="10"><I>Provide a single source of consistent<BR/>service information. </I></FONT>>]
software_development_itil4__service_management_practices [shape=box style=filled fillcolor="#dddddd" label=<<B>Service Management Practices</B><BR/><FONT POINT-SIZE="10"><I>Service management practices have been<BR/>developed in service management and ITSM<BR/>industries. </I></FONT>>]
 
